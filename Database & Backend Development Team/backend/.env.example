# Copy to .env and edit. Never commit .env (it is in .gitignore).

# PostgreSQL connection string (SQLAlchemy + psycopg 3).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pricematch_db

# Comma-separated list of allowed browser origins for the frontend ("*" = all, dev only).
CORS_ORIGINS=*

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Where the inflation study's daily price CSVs live (used only by scripts/seed_demo_data.py).
# INFLATION_DATAS=/path/to/InflationResearchStudy/InflationItems/Datas
